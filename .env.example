# ============================================================
# Tiệm Cafe Góc Nhỏ — Environment Variables
# ============================================================
# Copy file này thành .env và điền giá trị thực tế.
# KHÔNG commit .env vào git.

# App
APP_NAME=cafegocnho
APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL)
DB_USER=user
DB_PASSWORD=changeme
DB_NAME=cafegocnho
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MENU=menu-images
MINIO_BUCKET_QR=qr-codes

# Auth
JWT_SECRET=changeme-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=86400
STAFF_SESSION_EXPIRE_SECONDS=28800

# VietQR (thông tin ngân hàng mặc định — có thể thay đổi trong Admin → Cấu hình)
VIETQR_BANK_BIN=970432
VIETQR_ACCOUNT_NO=680180598
VIETQR_ACCOUNT_NAME=LUU VAN TU

# Rate Limit
RATE_LIMIT_ORDER_MAX=5
RATE_LIMIT_ORDER_WINDOW=300
RATE_LIMIT_PIN_MAX=5
RATE_LIMIT_PIN_WINDOW=900

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
